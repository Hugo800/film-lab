{
  "name": "film-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Film Lab – Film-Looks für Kamerafotos, komplett im Browser (WebGL2)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "fflate": "^0.8.2",
    "libraw-wasm": "^1.6.0",
    "lucide-react": "^0.513.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "puppeteer-core": "^24.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
